# Backend Environment Variables

# Application
APP_NAME=Web Education Platform API
APP_VERSION=1.0.0
DEBUG=True
API_V1_PREFIX=/api/v1

# Database
# ВАЖНО: Используйте порт 5433, чтобы избежать конфликта с родным PostgreSQL на macOS
DATABASE_URL=postgresql://wep_user:wep_password@127.0.0.1:5433/wep_education

# Realtime (optional for local)
# If you have redis locally: redis-server (or docker) on 6379
# REDIS_URL=redis://127.0.0.1:6379/0

# CORS (JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Security
SECRET_KEY=your-super-secret-key-change-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging (local defaults)
SERVICE_NAME=wep-backend
LOG_LEVEL=DEBUG
LOG_JSON=False
LOG_COLOR=True
