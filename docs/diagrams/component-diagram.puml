@startuml
title WEP LMS — Диаграмма основных компонентов системы

skinparam componentStyle rectangle
skinparam shadowing false
skinparam wrapWidth 240
skinparam maxMessageSize 120

package "Клиент" as client {
  component "GUI\n(Web Client, React/TS SPA)" as GUI <<component>>
}

package "Сервер" as server {
  component "API Controller\n(FastAPI, /api/v1)" as API <<component>>

  component "Auth Module" as AUTH <<component>>
  component "Access Control Module" as ACL <<component>>
  component "Classroom Module\n(classes + membership + invites)" as CLASSROOM <<component>>
  component "Lesson Module" as LESSON <<component>>
  component "Homework Module" as HOMEWORK <<component>>
  component "Problem Module\n(problem library)" as PROBLEM <<component>>
  component "Testing Module\n(answer submit/check)" as TESTING <<component>>
  component "Result/Statistics Module" as STATS <<component>>
  component "Theory Module" as THEORY <<component>>
  component "Chat Module\n(HTTP messages)" as CHAT <<component>>
  component "Realtime Chat Subsystem\n(WS + presence/typing)" as REALTIME <<component>>

  () "IAuth" as IAuth
  () "IAccessControl" as IAccessControl
  () "IClassroom" as IClassroom
  () "ILesson" as ILesson
  () "IHomework" as IHomework
  () "IProblem" as IProblem
  () "ITesting" as ITesting
  () "IStatistics" as IStatistics
  () "ITheory" as ITheory
  () "IChat" as IChat
  () "IRealtimeChat" as IRealtimeChat
  () "IDatabase" as IDatabase
  () "IPubSub" as IPubSub
}

package "Хранилище" as storage {
  database "Database System\n(PostgreSQL)" as DB <<database>>
  component "Redis\n(Pub/Sub + ephemeral presence)" as REDIS <<component>>
}

' Client ↔ Server (client–server interaction model)
GUI --> API : HTTP/REST (JSON DTO)
GUI <--> API : WebSocket (chat)

' API Controller uses domain modules through provided interfaces
API -- IAuth
API -- IAccessControl
API -- IClassroom
API -- ILesson
API -- IHomework
API -- IProblem
API -- ITesting
API -- IStatistics
API -- ITheory
API -- IChat
API -- IRealtimeChat

IAuth -- AUTH
IAccessControl -- ACL
IClassroom -- CLASSROOM
ILesson -- LESSON
IHomework -- HOMEWORK
IProblem -- PROBLEM
ITesting -- TESTING
IStatistics -- STATS
ITheory -- THEORY
IChat -- CHAT
IRealtimeChat -- REALTIME

' Inter-module dependencies (based on implemented MVP logic)
LESSON --> CLASSROOM : classroom context
HOMEWORK --> LESSON : homework belongs to lesson
HOMEWORK --> CLASSROOM : ownership/publish checks
HOMEWORK --> PROBLEM : homework composition (problem list)
TESTING --> HOMEWORK : validate homework
TESTING --> PROBLEM : validate problem + check answer
TESTING --> STATS : update attempts/status/score
STATS --> CLASSROOM : classroom progress via memberships
CHAT --> CLASSROOM : access rules (owner/member)
REALTIME --> CHAT : persist & broadcast messages
CLASSROOM --> ACL : access checks
LESSON --> ACL : access checks
HOMEWORK --> ACL : access checks
CHAT --> ACL : access checks

' Data persistence and realtime infrastructure
AUTH -- IDatabase
ACL -- IDatabase
CLASSROOM -- IDatabase
LESSON -- IDatabase
HOMEWORK -- IDatabase
PROBLEM -- IDatabase
TESTING -- IDatabase
STATS -- IDatabase
THEORY -- IDatabase
CHAT -- IDatabase

REALTIME -- IPubSub

IDatabase -- DB : SQL
IPubSub -- REDIS : Pub/Sub

@enduml


