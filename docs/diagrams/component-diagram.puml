@startuml
title WEP LMS — System component diagram (MVP, code-based)

skinparam componentStyle rectangle
skinparam shadowing false
skinparam wrapWidth 220
skinparam maxMessageSize 120

package "Client" as client {
  component "GUI\n(Web Client, React/TS SPA)" as GUI <<component>>
}

package "Server (Backend API)" as server {
  package "Transport layer" as transport {
    component "FastAPI Application\n(routers + dependencies + WS)" as API <<component>>

    () "REST API\n(/api/v1)" as IRest <<interface>>
    () "WebSocket Chat\n(/api/v1/.../chat/ws)" as IWs <<interface>>
  }

  package "Service layer" as services {
    component "AuthService" as AUTH <<component>>
    component "ClassroomService" as CLASSROOM <<component>>
    component "LessonService" as LESSON <<component>>
    component "HomeworkService" as HOMEWORK <<component>>
    component "ProblemService" as PROBLEM <<component>>
    component "TestingService" as TESTING <<component>>
    component "ResultService\n(progress/statistics)" as STATS <<component>>
    component "TheoryService" as THEORY <<component>>
    component "ChatService\n(HTTP chat history)" as CHAT <<component>>

    component "Access control helpers\n(pure access checks)" as ACL <<component>>
    component "Realtime chat runtime\n(manager + broker)" as REALTIME <<component>>

    () "IAuth" as IAuth <<interface>>
    () "IClassroom" as IClassroom <<interface>>
    () "ILesson" as ILesson <<interface>>
    () "IHomework" as IHomework <<interface>>
    () "IProblem" as IProblem <<interface>>
    () "ITesting" as ITesting <<interface>>
    () "IResults" as IResults <<interface>>
    () "ITheory" as ITheory <<interface>>
    () "IChat" as IChat <<interface>>
  }

  package "Data access layer" as dal {
    component "SQLAlchemy AsyncSession\n(db/session.py)" as SESSION <<component>>
    component "Repositories\n(app/repositories/*)" as REPOS <<component>>

    () "IUserRepository" as IUserRepo <<interface>>
    () "IClassroomRepository" as IClassroomRepo <<interface>>
    () "ILessonRepository" as ILessonRepo <<interface>>
    () "IHomeworkRepository" as IHomeworkRepo <<interface>>
    () "IProblemRepository" as IProblemRepo <<interface>>
    () "IStatisticsRepository" as IStatsRepo <<interface>>
    () "IChatRepository" as IChatRepo <<interface>>
  }
}

package "Storage" as storage {
  database "PostgreSQL" as DB <<database>>
  component "Redis\n(Pub/Sub + ephemeral presence)" as REDIS <<component>>
}

' External interfaces provided by FastAPI Application
API -- IRest
API -- IWs

' Client ↔ Server (by interfaces)
GUI --> IRest : HTTP/REST (JSON)
GUI <--> IWs : WebSocket (events)

' Transport → Service interfaces
API -- IAuth
API -- IClassroom
API -- ILesson
API -- IHomework
API -- IProblem
API -- ITesting
API -- IResults
API -- ITheory
API -- IChat

' Service interfaces → implementations
IAuth -- AUTH
IClassroom -- CLASSROOM
ILesson -- LESSON
IHomework -- HOMEWORK
IProblem -- PROBLEM
ITesting -- TESTING
IResults -- STATS
ITheory -- THEORY
IChat -- CHAT

' WS handlers (part of FastAPI app) use realtime runtime and persist history via chat service
API --> REALTIME : WS delivery/presence
API --> CHAT : persist history (fallback)

' Services → shared access rules (used only where imported in code)
CLASSROOM --> ACL
LESSON --> ACL
HOMEWORK --> ACL
CHAT --> ACL

' Services → Repository interfaces (contracts)
AUTH --> IUserRepo
CLASSROOM --> IClassroomRepo
CLASSROOM --> IUserRepo
LESSON --> ILessonRepo
LESSON --> IClassroomRepo
HOMEWORK --> IHomeworkRepo
HOMEWORK --> IProblemRepo
HOMEWORK --> ILessonRepo
HOMEWORK --> IClassroomRepo
HOMEWORK --> IUserRepo
PROBLEM --> IProblemRepo
TESTING --> IHomeworkRepo
TESTING --> IProblemRepo
TESTING --> IStatsRepo
TESTING --> IUserRepo
STATS --> IStatsRepo
STATS --> IHomeworkRepo
STATS --> IClassroomRepo
STATS --> IUserRepo
THEORY --> ILessonRepo
CHAT --> IChatRepo
CHAT --> IClassroomRepo
CHAT --> IUserRepo

' Repository interfaces are implemented by the Repositories component
REPOS -- IUserRepo
REPOS -- IClassroomRepo
REPOS -- ILessonRepo
REPOS -- IHomeworkRepo
REPOS -- IProblemRepo
REPOS -- IStatsRepo
REPOS -- IChatRepo

REPOS --> SESSION : uses
API --> SESSION : get_db()

SESSION --> DB : SQL

' Realtime infrastructure
REALTIME <--> REDIS : Pub/Sub + presence/typing

note right of ACL
  Used to keep authorization rules consistent.
  Does not query storage directly; it validates
  using already-loaded domain objects.
end note

@enduml


