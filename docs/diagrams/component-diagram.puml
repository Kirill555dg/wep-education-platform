@startuml
title WEP LMS — System component diagram (MVP, code-based)

skinparam componentStyle rectangle
skinparam shadowing false
skinparam wrapWidth 220
skinparam maxMessageSize 120

package "Client" as client {
  component "GUI\n(Web Client, React/TS SPA)" as GUI <<component>>
}

package "Server (Backend API)" as server {
  package "Transport layer" as transport {
    component "API Controller\n(FastAPI routers + dependencies)" as API <<component>>
    component "Realtime endpoints\n(WebSocket handlers)" as WS <<component>>
  }

  package "Service layer" as services {
    component "AuthService" as AUTH <<component>>
    component "ClassroomService" as CLASSROOM <<component>>
    component "LessonService" as LESSON <<component>>
    component "HomeworkService" as HOMEWORK <<component>>
    component "ProblemService" as PROBLEM <<component>>
    component "TestingService" as TESTING <<component>>
    component "ResultService\n(progress/statistics)" as STATS <<component>>
    component "TheoryService" as THEORY <<component>>
    component "ChatService\n(HTTP chat history)" as CHAT <<component>>

    component "Access control helpers\n(services/access_control.py)" as ACL <<component>>
    component "Realtime chat runtime\n(manager + broker)" as REALTIME <<component>>
  }

  package "Data access layer" as dal {
    component "SQLAlchemy AsyncSession\n(db/session.py)" as SESSION <<component>>
    component "Repositories\n(app/repositories/*)" as REPOS <<component>>
  }
}

package "Storage" as storage {
  database "PostgreSQL" as DB <<database>>
  component "Redis\n(Pub/Sub + ephemeral presence)" as REDIS <<component>>
}

' Client ↔ Server
GUI --> API : HTTP/REST (JSON)
GUI <--> WS : WebSocket (chat)

' Transport → Services (FastAPI Depends + DTO mapping)
API --> AUTH
API --> CLASSROOM
API --> LESSON
API --> HOMEWORK
API --> PROBLEM
API --> TESTING
API --> STATS
API --> THEORY
API --> CHAT

WS --> REALTIME
WS --> CHAT : persist history (fallback)

' Services → shared access rules (used only where imported in code)
CLASSROOM --> ACL
LESSON --> ACL
HOMEWORK --> ACL
CHAT --> ACL

' Services → DAL
AUTH --> REPOS
CLASSROOM --> REPOS
LESSON --> REPOS
HOMEWORK --> REPOS
PROBLEM --> REPOS
TESTING --> REPOS
STATS --> REPOS
THEORY --> REPOS
CHAT --> REPOS

REPOS --> SESSION : uses
API --> SESSION : get_db()
WS --> SESSION : get_db()

SESSION --> DB : SQL

' Realtime infrastructure
REALTIME <--> REDIS : Pub/Sub + presence/typing

@enduml


