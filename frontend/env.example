# API base URL
# - dev default (if not set): http://127.0.0.1:8023
# - prod default (if not set): "" (same-origin; nginx proxies /api)
VITE_API_URL=http://127.0.0.1:8023

# Deterministic Mock API (recommended only for local dev)
VITE_USE_MOCK_API=false
VITE_MOCK_SEED=wep

# Cypress (only used in `bun run test:e2e` via script/env)
CYPRESS_BACKEND_URL=http://127.0.0.1:8023


